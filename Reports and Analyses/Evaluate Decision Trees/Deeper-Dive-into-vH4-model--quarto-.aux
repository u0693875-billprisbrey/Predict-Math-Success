\relax 
\providecommand*\new@tpo@label[2]{}
\providecommand\hyper@newdestlabel[2]{}
\providecommand*\HyPL@Entry[1]{}
\HyPL@Entry{0<</S/D>>}
\@writefile{toc}{\contentsline {section}{\nonumberline METHODLOGY}{1}{section*.1}\protected@file@percent }
\newlabel{methodlogy}{{}{1}{METHODLOGY}{section*.1}{}}
\@writefile{toc}{\contentsline {section}{\nonumberline DISCUSSION}{1}{section*.2}\protected@file@percent }
\newlabel{discussion}{{}{1}{DISCUSSION}{section*.2}{}}
\@writefile{toc}{\contentsline {section}{\nonumberline CONCLUSIONS}{2}{section*.3}\protected@file@percent }
\newlabel{conclusions}{{}{2}{CONCLUSIONS}{section*.3}{}}
\@writefile{toc}{\contentsline {section}{\nonumberline POSSIBLE NEXT STEPS}{3}{section*.4}\protected@file@percent }
\newlabel{possible-next-steps}{{}{3}{POSSIBLE NEXT STEPS}{section*.4}{}}
\@writefile{toc}{\contentsline {section}{\nonumberline RESULTS}{3}{section*.5}\protected@file@percent }
\newlabel{results}{{}{3}{RESULTS}{section*.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Model compared to the timeline of actual student experience}}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig-pipeline}{{1}{3}{Model compared to the timeline of actual student experience}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Regression Results}}{4}{table.caption.7}\protected@file@percent }
\newlabel{tbl-results}{{1}{4}{Regression Results}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces These plots show what the correct prediction value would be with a red line.}}{4}{figure.caption.8}\protected@file@percent }
\newlabel{fig-results_scatter_box}{{2}{4}{These plots show what the correct prediction value would be with a red line}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The model tends to predict towards the center, while most students earn an `A'.}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig-density}{{3}{5}{The model tends to predict towards the center, while most students earn an `A'}{figure.caption.9}{}}
